# Local production secrets for MyFinance — COPY this file to scripts/.env.prod and fill in values.
# scripts/.env.prod is gitignored; never commit real secrets.
#
# start-prod.sh sources this file (exporting each var) before launching the backend.

# Master key for encrypting stored broker API credentials (AES-256-GCM).
# MUST be a base64-encoded 16/24/32-byte key. 32 bytes (AES-256) is recommended.
# Generate one with:  openssl rand -base64 32
# WARNING: keep this key stable and backed up. If it changes or is lost, previously
# saved broker credentials become unrecoverable and must be re-entered.
CREDENTIAL_MASTER_KEY=

# Optional: enable the internal provisioning endpoints (leave empty to keep them disabled/503).
# PROVISIONING_TOKEN=
